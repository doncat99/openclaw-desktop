#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_CODEX_REVIEW:-0}" == "1" ]]; then
  echo "[pre-push] SKIP_CODEX_REVIEW=1 set; skipping Codex review."
  exit 0
fi

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT_DIR"

echo "[pre-push] Running Codex code review (uncommitted changes)..."
bash scripts/codex-review.sh --uncommitted
